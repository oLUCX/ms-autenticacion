  "item": [
    {
      "name": "Crear usuario COMERCIO (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"username\", \"tienda-sur-\" + (Date.now() % 100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"usuarioId\", pm.response.json().id);",
              "pm.test(\"pm.response.json().password === undefined\", () => pm.expect(pm.response.json().password === undefined).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"clave-segura-123\",\n  \"rol\": \"COMERCIO\",\n  \"comercioId\": \"comercio-123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
